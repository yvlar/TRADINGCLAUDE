ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
# Clé Bearer pour l'API — laisser vide en dev (bypass auth total)
# En prod, définir une valeur et l'entrer sur /login dans le frontend
API_KEY=
# Modèle Haiku pour skills mécaniques/quantitatifs (Sprint 44)
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
DATABASE_URL=postgresql://copilote:copilote@postgres:5432/copilote
POSTGRES_PASSWORD=copilote
LOG_LEVEL=INFO
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=investment_knowledge
RAG_TOP_K=5
OPENAI_API_KEY=sk-...
LOG_FORMAT=text
CLAUDE_TIMEOUT_S=60
CLAUDE_MAX_RETRIES=3
# Langfuse — optionnel. Si absent, le traçage Langfuse est désactivé.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Webhook — Sprint 56. Si absent, les notifications webhook sont désactivées (skip silencieux).
WEBHOOK_URL=           # URL webhook Slack/Discord/n8n (optionnel)
WEBHOOK_SECRET=        # Header X-Webhook-Secret pour authentification (optionnel)
# Slack Incoming Webhook — Sprint 86. Si absent, toutes les méthodes SlackService retournent False.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/VOTRE_WEBHOOK_ICI
# Email — Sprint 25. Si absent, l'envoi email est désactivé (log WARNING).
# Option A : SMTP stdlib (ex: Gmail, Desjardins)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-application
REPORT_EMAIL_TO=yves@exemple.com
# Option B : SendGrid (prioritaire si SENDGRID_API_KEY est présent)
SENDGRID_API_KEY=SG.votre-cle-sendgrid
SENDGRID_FROM_EMAIL=noreply@tradingclaude.app
# Auth JWT — Sprint login. Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=votre-secret-jwt-ici-minimum-32-caracteres
# URL du frontend (utilisé pour les liens dans les emails de reset)
FRONTEND_URL=http://localhost:5173
# Cookies Secure (HTTPS) — mettre à true en production uniquement
SECURE_COOKIES=false
